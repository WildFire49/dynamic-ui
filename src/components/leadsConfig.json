{
  "title": "Lead Management",
  "search": {
    "placeholder": "Search by name, address, requirement, or phone...",
    "maxWidth": 600,
    "startIcon": "Search",
    "searchableFields": [
      "name",
      "address",
      "requirement",
      "sourcedBy",
      "mobileNumber"
    ],
    "showCount": true,
    "countLabel": "prospect",
    "emptyMessage": "No prospects found",
    "emptyHint": "Try adjusting your search criteria"
  },
  "cardLayout": {
    "idKey": "id",
    "header": {
      "showAvatar": true,
      "avatarKey": "name",
      "avatarSize": 56,
      "titleKey": "name",
      "chipKey": "requirement",
      "minHeight": "72px"
    },
    "fields": [
      {
        "id": "address",
        "dataKey": "address",
        "icon": "LocationOn",
        "iconSize": 18,
        "fontSize": "0.85rem",
        "alignItems": "flex-start",
        "minHeight": "38px",
        "clamp": 2
      },
      {
        "id": "phone",
        "dataKey": "mobileNumber",
        "icon": "Phone",
        "iconSize": 18,
        "fontSize": "0.85rem",
        "minHeight": "24px"
      },
      {
        "id": "amount",
        "dataKey": "amount",
        "icon": "AttachMoney",
        "iconSize": 18,
        "fontSize": "0.85rem",
        "fontWeight": 600,
        "textColor": "success.main",
        "minHeight": "24px"
      },
      {
        "id": "sourcedBy",
        "dataKey": "sourcedBy",
        "icon": "Person",
        "iconSize": 18,
        "fontSize": "0.85rem",
        "prefix": "Sourced by:",
        "bold": true,
        "minHeight": "24px"
      }
    ]
  },
  "dialog": {
    "maxWidth": "md",
    "showAvatar": true,
    "avatarKey": "name",
    "titleKey": "name",
    "subtitle": "Customer Details",
    "showEditButton": true,
    "sections": [
      {
        "id": "lead_details",
        "title": "Lead Information",
        "subtitle": "Complete lead details",
        "icon": "person",
        "fields": [
          {
            "id": "name",
            "label": "Full Name",
            "dataKey": "name",
            "type": "text",
            "placeholder": "Enter full name",
            "xs": 12,
            "md": 6,
            "required": true,
            "disabled": true,
            "icon": "person"
          },
          {
            "id": "mobileNumber",
            "label": "Mobile Number",
            "dataKey": "mobileNumber",
            "type": "text",
            "placeholder": "Enter mobile number",
            "xs": 12,
            "md": 6,
            "required": true,
            "disabled": true,
            "icon": "phone"
          },
          {
            "id": "email",
            "label": "Email",
            "dataKey": "email",
            "type": "email",
            "placeholder": "Enter email address",
            "xs": 12,
            "md": 6,
            "required": true,
            "disabled": true,
            "icon": "email"
          },
          {
            "id": "address",
            "label": "Address",
            "dataKey": "address",
            "type": "text",
            "placeholder": "Enter address",
            "xs": 12,
            "md": 6,
            "disabled": true,
            "icon": "home"
          },
          {
            "id": "requirement",
            "label": "Requirement",
            "dataKey": "requirement",
            "type": "select",
            "placeholder": "Select requirement",
            "xs": 12,
            "md": 6,
            "disabled": true,
            "options": [
              { "value": "Home Loan", "label": "Home Loan" },
              { "value": "Personal Loan", "label": "Personal Loan" },
              { "value": "Business Loan", "label": "Business Loan" },
              { "value": "Auto Loan", "label": "Auto Loan" }
            ]
          },
          {
            "id": "amount",
            "label": "Amount",
            "dataKey": "amount",
            "type": "text",
            "placeholder": "Enter amount",
            "xs": 12,
            "md": 6,
            "disabled": true
          },
          {
            "id": "loanType",
            "label": "Loan Type",
            "dataKey": "loanType",
            "type": "select",
            "placeholder": "Select loan type",
            "xs": 12,
            "md": 6,
            "disabled": true,
            "options": [
              { "value": "Home Loan", "label": "Home Loan" },
              { "value": "Personal Loan", "label": "Personal Loan" },
              { "value": "Business Loan", "label": "Business Loan" },
              { "value": "Auto Loan", "label": "Auto Loan" }
            ]
          },
          {
            "id": "sourcedBy",
            "label": "Sourced By",
            "dataKey": "sourcedBy",
            "type": "text",
            "placeholder": "Enter source name",
            "xs": 12,
            "md": 6,
            "disabled": true,
            "icon": "person"
          },
          {
            "id": "income",
            "label": "Annual Income",
            "dataKey": "income",
            "type": "text",
            "placeholder": "Enter annual income",
            "xs": 12,
            "md": 4,
            "disabled": true
          },
          {
            "id": "creditScore",
            "label": "Credit Score",
            "dataKey": "creditScore",
            "type": "number",
            "placeholder": "Enter credit score",
            "xs": 12,
            "md": 4,
            "disabled": true
          },
          {
            "id": "employmentStatus",
            "label": "Employment Status",
            "dataKey": "employmentStatus",
            "type": "select",
            "placeholder": "Select employment status",
            "xs": 12,
            "md": 4,
            "disabled": true,
            "options": [
              { "value": "Full-time", "label": "Full-time" },
              { "value": "Part-time", "label": "Part-time" },
              { "value": "Self-employed", "label": "Self-employed" },
              { "value": "Unemployed", "label": "Unemployed" }
            ]
          },
          {
            "id": "notes",
            "label": "Notes",
            "dataKey": "notes",
            "type": "text",
            "placeholder": "Enter any additional notes",
            "xs": 12,
            "multiline": true,
            "rows": 3,
            "disabled": true
          }
        ]
      }
    ]
  },
  "dialogActions": {
    "actions": [
      {
        "id": "Accept",
        "label": "Accept",
        "action": "accept",
        "variant": "contained",
        "color": "success",
        "showIf": "viewing",
        "disabled": true
      },
      {
        "id": "reject",
        "label": "Reject",
        "action": "reject",
        "variant": "contained",
        "color": "error",
        "showIf": "viewing",
        "disabled": true
      },
      {
        "id": "review",
        "label": "Review",
        "action": "review",
        "variant": "contained",
        "color": "warning",
        "showIf": "viewing",
        "disabled": true
      },
      {
        "id": "close",
        "label": "Close",
        "action": "close",
        "variant": "contained",
        "color": "primary",
        "showIf": "viewing",
        "disabled": false
      }
    ]
  },
